{
  "name": "osury",
  "type": "module",
  "description": "Generate ReScript types with Sury schemas from OpenAPI specifications",
  "version": "2.7.0",
  "license": "MIT",
  "bin": {
    "osury": "dist/osury.mjs"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "res:clean": "rescript clean",
    "res:build": "rescript",
    "res:dev": "rescript watch",
    "codegen": "node scripts/codegen.mjs",
    "demo": "npm --prefix demo run dev",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "build:bin": "node scripts/build-bin.mjs",
    "prepublishOnly": "npm run res:build && npm test && npm run build:bin"
  },
  "devDependencies": {
    "@rescript/core": "^1.6.1",
    "effect": "^4.0.0-beta.78",
    "esbuild": "^0.28.0",
    "gentype": "^4.5.0",
    "jest": "^30.2.0",
    "rescript": "^12.1.0",
    "sury": "^11.0.0-rc.1",
    "sury-ppx": "^11.0.0-rc.1"
  },
  "peerDependencies": {
    "sury": ">=11.0.0-rc.1",
    "sury-ppx": ">=11.0.0-rc.1"
  },
  "peerDependenciesMeta": {
    "sury": {
      "optional": true
    },
    "sury-ppx": {
      "optional": true
    }
  },
  "keywords": [
    "openapi",
    "rescript",
    "codegen",
    "sury",
    "schema",
    "typescript",
    "types"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greenteamer/osury.git"
  }
}
